# Node.js & Vite project ignore patterns
# -----------------------------------

# Dependency directories
node_modules/

# Build output
dist/
build/

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files (keep secrets out of version control)
.env
.env.*

# OS & editor artifacts
.DS_Store
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Coverage reports
coverage/

# Temporary files
.tmp/
